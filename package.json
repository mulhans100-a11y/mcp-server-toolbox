{
  "name": "local-developer-toolbox-mcp",
  "version": "0.1.0",
  "description": "A local MCP server that gives AI coding assistants safe, focused developer tools.",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "developer-tools",
    "typescript",
    "docker",
    "git",
    "conventional-commits",
    "logs",
    "json"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown",
    "check": "npm run format:check && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "safe-regex2": "^5.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
